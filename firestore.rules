rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public read for published stories only; Admin can read and write all
    match /stories/{storyId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Programs: public read for active programs; Admin full access
    match /programs/{programId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Site settings: public read for general settings; Admin full access
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries: Created only via trusted server-side Route Handlers (Admin SDK)
    // Client write is blocked or restricted; Public read blocked; Admin read/delete
    match /inquiries/{inquiryId} {
      allow read, delete, update: if isAdmin();
      allow create: if false; // Only server-side route handler with Firebase Admin SDK
    }

    // Donations: Recorded only by trusted server-side PayPal capture endpoint (Admin SDK)
    // Public read and write blocked; Admin read only
    match /donations/{donationId} {
      allow read: if isAdmin();
      allow write: if false; // Only server-side route handler with Firebase Admin SDK
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
