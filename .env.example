# ==============================================================================
# FAITH FOUNTAIN FOUNDATION - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC APP CONFIGURATION
# ------------------------------------------------------------------------------
# Production or local domain for canonical URLs, sitemaps, and OpenGraph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Safe for browser exposure)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="faith-fountain-foundation.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="faith-fountain-foundation"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="faith-fountain-foundation.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CONFIGURATION (STRICTLY SERVER-SIDE ONLY)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="faith-fountain-foundation"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@faith-fountain-foundation.iam.gserviceaccount.com"
# Note: In .env.local, wrap the private key in quotes and preserve \n line breaks
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR CONFIGURATION
# Authorized administrator email allowed to manage the foundation's dashboard
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="faithfountain2022@gmail.com"

# ------------------------------------------------------------------------------
# 5. PAYPAL CHECKOUT CONFIGURATION
# Obtain credentials from developer.paypal.com -> Dashboard -> Apps & Credentials
# ------------------------------------------------------------------------------
# PayPal Client ID (Used by PayPal SDK in frontend and server)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"

# PayPal Client Secret (STRICTLY SERVER-SIDE - NEVER EXPOSE IN BROWSER)
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"

# PayPal Mode: "sandbox" for development/testing, "live" for production donations
# Must remain "sandbox" until real merchant account testing is completed
PAYPAL_MODE="sandbox"

# Supported currencies for donations (comma-separated): CAD, USD, EUR, GBP
NEXT_PUBLIC_PAYPAL_CURRENCIES="CAD,USD,EUR,GBP"
NEXT_PUBLIC_DEFAULT_CURRENCY="CAD"

# ------------------------------------------------------------------------------
# 6. OPTIONAL TRANSACTIONAL EMAIL CONFIGURATION
# (Resend, SendGrid, or SMTP if email notification is enabled in the future)
# ------------------------------------------------------------------------------
EMAIL_SERVICE_API_KEY=""
NOTIFICATION_RECIPIENT_EMAIL="faithfountain2022@gmail.com"




